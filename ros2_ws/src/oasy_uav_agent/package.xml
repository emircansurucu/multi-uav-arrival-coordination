<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oasy_uav_agent</name>
  <version>0.1.0</version>
  <description>
    Her hava aracinda bagimsiz calisan karar node'u. Arac telemetrisini
    AP_DDS uzerinden okur, kendi durumunu koordinasyon domain'ine yayinlar
    ve diger araclari dinleyerek kendi varis zamanlamasini belirler.
  </description>
  <maintainer email="surucuemircan49@gmail.com">Emircan Surucu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>oasy_interfaces</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
